#!/bin/sh
set -eu

if [ -x ".venv/Scripts/python.exe" ]; then
  PYTHON=".venv/Scripts/python.exe"
elif [ -x ".venv/bin/python" ]; then
  PYTHON=".venv/bin/python"
else
  PYTHON="python"
fi

echo "[pre-commit] Ruff critical errors"
# Porte unique, partagee avec la CI : voir tools/lint_gate.sh. Ne pas remettre
# un `ruff check` en dur ici -- c'est la divergence entre ce hook et la CI qui
# a laisse le voyant rouge en permanence.
sh tools/lint_gate.sh

echo "[pre-commit] Fast safety tests"
"$PYTHON" -m pytest -q \
  tests/test_cost_conventions.py \
  tests/test_llm_timeout.py \
  tests/test_live_demo_cluster_journal.py \
  tests/test_llm_skills_catalog.py
