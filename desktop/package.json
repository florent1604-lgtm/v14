{
  "name": "titanium-v14-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Application Windows locale pour Titanium V14",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "pack": "electron-builder --win portable nsis"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "fr.titanium.v14.controlcenter",
    "productName": "Titanium V14 Control Center",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app-config.json",
      "lib/**/*",
      "package.json"
    ],
    "win": {
      "target": ["portable", "nsis"],
      "artifactName": "Titanium-V14-Control-Center-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
